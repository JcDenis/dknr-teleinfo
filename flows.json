        "name": "tariff",
        "func": "let res = [];\nlet i = 0;\nlet exists = false;\n\nif (typeof msg.payload.OPTARIF == 'object') {\n    res[i++] = {\n        'lbl': msg.payload.OPTARIF.name,\n        'val': msg.payload.OPTARIF.full\n    };\n    exists = true;\n}\n\nif (typeof msg.payload.ISOUSC == 'object') {\n    res[i++] = {\n        'lbl': msg.payload.ISOUSC.name,\n        'val': msg.payload.ISOUSC.full + ' A'\n    }\n    exists = true;\n}\n\nif (typeof msg.payload.PTEC == 'object') {\n    res[i++] = {\n        'lbl': msg.payload.PTEC.name,\n        'val': msg.payload.PTEC.full,\n    }\n    exists = true;\n}\n\nif (exists === true) {\n    msg.payload = res;\n    msg.class = '';\n\n    return msg;\n}\n\nreturn;",
