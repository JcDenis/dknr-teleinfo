    {
        "id": "21405f35d4bbf057",
        "type": "function",
        "z": "4bc72a1112cb448c",
        "g": "4a03c4c9cfd20732",
        "name": "papp",
        "func": "let voltage = 240;\nlet res = {\n    'topic': '',\n    'payload': '-',\n    'class': 'remove',\n    'enabled': false\n}\n\nif (typeof msg.payload.PAPP == 'object' && typeof msg.payload.ISOUSC == 'object') {\n    res = {\n        'topic': '',\n        'ui_update': {\n            'label': msg.payload.PAPP.name + ' :',\n            'gtype': 'gauge-half',\n            'gstyle': 'rounded',\n            'min': 0,\n            'max': (msg.payload.ISOUSC.value + 2) * voltage,\n            'segments': [\n                { 'color': 'blue', 'from': 0},\n                { 'color': 'green', 'from': Math.floor(msg.payload.ISOUSC.value * voltage  / 3) },\n                { 'color': 'orange', 'from': Math.floor(msg.payload.ISOUSC.value * voltage * 2 / 3) },\n                { 'color': 'red', 'from': msg.payload.ISOUSC.value * voltage }\n            ],\n            'units': 'VA'\n        },\n        'payload': msg.payload.PAPP.value,\n        'class': '',\n        'enabled': true\n    };\n}\n\nreturn res;",
