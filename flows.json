        "name": "iinst",
        "func": "let res = {\n    'topic': '',\n    'ui_update': {},\n    'payload': '-',\n    'class': 'remove',\n    'enabled': false\n}\n\nif (typeof msg.payload.IINST == 'object' && typeof msg.payload.ISOUSC == 'object') {\n    res = {\n        'topic': '',\n        'ui_update': {\n            'label': msg.payload.IINST.name + ' :',\n            'gtype': 'gauge-half',\n            'gstyle': 'rounded',\n            'min': 0,\n            'max': msg.payload.ISOUSC.value + 2,\n            'segments': [\n                { 'color': 'blue', 'from': 0},\n                { 'color': 'green', 'from': Math.floor(msg.payload.ISOUSC.value / 3) },\n                { 'color': 'orange', 'from': Math.floor(msg.payload.ISOUSC.value * 2 / 3) },\n                { 'color': 'red', 'from': msg.payload.ISOUSC.value }\n            ],\n            'units': 'Ampère'\n        },\n        'payload': msg.payload.IINST.value,\n        'class': '',\n        'enabled': true\n    };\n}\n\nreturn res;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
